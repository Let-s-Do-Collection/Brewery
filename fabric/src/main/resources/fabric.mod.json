{
  "schemaVersion": 1,
  "id": "brewery",
  "version": "${version}",
  "name": "[Let's Do] Brewery",
  "description": "Foaming mugs, copper kettles and the smell of fresh pretzels. Brew your own beer, cook hearty food and throw an Oktoberfest to remember.",
  "authors": [
    "satisfy"
  ],
  "contributors": [
    "MissLilitu",
    "CR-055"
  ],
  "contact": {
    "issues": "https://github.com/satisfyu/Let-s-Do-Hub",
    "sources": "https://github.com/satisfyu/Brewery",
    "homepage": "https://www.lets-do.ch",
    "wiki": "https://lets-do.ch/wiki/brewery/"
  },
  "license": "Custom",
  "icon": "pack.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.satisfy.brewery.fabric.BreweryFabric"
    ],
    "client": [
      "net.satisfy.brewery.fabric.client.BreweryClientFabric"
    ],
    "rei_client": [
      "net.satisfy.brewery.fabric.core.rei.BreweryREIClientPluginFabric"
    ],
    "emi": [
      "net.satisfy.brewery.core.compat.emi.BreweryEMIPlugin"
    ],
    "jei_mod_plugin": [
      "net.satisfy.brewery.core.compat.jei.BreweryJEIClientPlugin"
    ],
    "modmenu": [
      "net.satisfy.brewery.fabric.core.config.ModMenu"
    ]
  },
  "mixins": [
    "brewery-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "fabric-api": "*",
    "minecraft": ">=1.21.1 <1.22",
    "architectury": ">=13.0.8",
    "foundation": ">=1.0.3",
    "farm_and_charm": ">=1.1.27"
  }
}
